From d2995d3f75dfaac532e8e255bcaef6d3a00f52b8 Mon Sep 17 00:00:00 2001
From: Bartosz Bilas <b.bilas@grinn-global.com>
Date: Thu, 22 Oct 2026 09:45:23 +0200
Subject: [PATCH] misc: add MediaTek eFuse driver

Add a read-only misc driver for the MediaTek eFuse block, based on the
Linux mtk-efuse driver. With CONFIG_NVMEM it lets consumers read eFuse
cells through nvmem-cells, e.g. an Ethernet "mac-address" cell.

Signed-off-by: Bartosz Bilas <b.bilas@grinn-global.com>
---
 drivers/misc/Kconfig     |  7 +++++
 drivers/misc/Makefile    |  1 +
 drivers/misc/mtk-efuse.c | 65 ++++++++++++++++++++++++++++++++++++++++
 3 files changed, 73 insertions(+)
 create mode 100644 drivers/misc/mtk-efuse.c

diff --git a/drivers/misc/Kconfig b/drivers/misc/Kconfig
index a6da6e215d..2fc2ed19bf 100644
--- a/drivers/misc/Kconfig
+++ b/drivers/misc/Kconfig
@@ -83,6 +83,13 @@ config GATEWORKS_SC
 	  boards to provide a boot watchdog, power control, temperature monitor,
 	  voltage ADCs, and EEPROM.
 
+config MTK_EFUSE
+	bool "MediaTek eFuse support"
+	depends on ARCH_MEDIATEK && MISC
+	help
+	  Enable read-only access to the eFuse block found in MediaTek SoCs,
+	  e.g. to read an Ethernet MAC address through nvmem-cells.
+
 config ROCKCHIP_EFUSE
         bool "Rockchip e-fuse support"
 	depends on MISC
diff --git a/drivers/misc/Makefile b/drivers/misc/Makefile
index d494639cd9..d31b03960b 100644
--- a/drivers/misc/Makefile
+++ b/drivers/misc/Makefile
@@ -54,6 +54,7 @@ obj-$(CONFIG_LED_STATUS) += status_led.o
 obj-$(CONFIG_LED_STATUS_GPIO) += gpio_led.o
 obj-$(CONFIG_MPC83XX_SERDES) += mpc83xx_serdes.o
 obj-$(CONFIG_$(SPL_TPL_)LS2_SFP) += ls2_sfp.o
+obj-$(CONFIG_MTK_EFUSE) += mtk-efuse.o
 obj-$(CONFIG_$(SPL_)MXC_OCOTP) += mxc_ocotp.o
 obj-$(CONFIG_MXS_OCOTP) += mxs_ocotp.o
 obj-$(CONFIG_NPCM_OTP) += npcm_otp.o
diff --git a/drivers/misc/mtk-efuse.c b/drivers/misc/mtk-efuse.c
new file mode 100644
index 0000000000..5afa8254ad
--- /dev/null
+++ b/drivers/misc/mtk-efuse.c
@@ -0,0 +1,65 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * MediaTek eFuse read-only driver, based on the Linux mtk-efuse driver.
+ *
+ * Copyright (C) 2026 Grinn sp. z o.o.
+ */
+
+#include <common.h>
+#include <dm.h>
+#include <mapmem.h>
+#include <misc.h>
+#include <asm/io.h>
+
+struct mtk_efuse_plat {
+	void __iomem *base;
+	fdt_size_t size;
+};
+
+static int mtk_efuse_read(struct udevice *dev, int offset,
+			  void *buf, int size)
+{
+	struct mtk_efuse_plat *plat = dev_get_plat(dev);
+	u8 *val = buf;
+	int i;
+
+	if (offset < 0 || size < 0 || offset + size > plat->size)
+		return -EINVAL;
+
+	for (i = 0; i < size; i++)
+		val[i] = readb(plat->base + offset + i);
+
+	return size;
+}
+
+static const struct misc_ops mtk_efuse_ops = {
+	.read = mtk_efuse_read,
+};
+
+static int mtk_efuse_of_to_plat(struct udevice *dev)
+{
+	struct mtk_efuse_plat *plat = dev_get_plat(dev);
+	fdt_addr_t addr;
+
+	addr = dev_read_addr_size_index(dev, 0, &plat->size);
+	if (addr == FDT_ADDR_T_NONE)
+		return -EINVAL;
+
+	plat->base = map_sysmem(addr, plat->size);
+
+	return 0;
+}
+
+static const struct udevice_id mtk_efuse_ids[] = {
+	{ .compatible = "mediatek,efuse" },
+	{}
+};
+
+U_BOOT_DRIVER(mtk_efuse) = {
+	.name = "mtk_efuse",
+	.id = UCLASS_MISC,
+	.of_match = mtk_efuse_ids,
+	.of_to_plat = mtk_efuse_of_to_plat,
+	.plat_auto = sizeof(struct mtk_efuse_plat),
+	.ops = &mtk_efuse_ops,
+};
-- 
